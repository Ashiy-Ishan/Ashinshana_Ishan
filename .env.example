# ==============================================================================
# Environment Configuration (.env or .env.local)
# ==============================================================================

# Firebase Web Client Configuration (from Firebase Console -> Project Settings)
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
REACT_APP_FIREBASE_APP_ID=your_firebase_app_id
REACT_APP_FIREBASE_MEASUREMENT_ID=your_measurement_id
# Set after registering this web app with Firebase App Check reCAPTCHA Enterprise.
# REACT_APP_FIREBASE_APP_CHECK_SITE_KEY=your_recaptcha_enterprise_site_key

# Admin email must match the verified account in firestore.rules and storage.rules.
REACT_APP_ADMIN_EMAIL=ashinshanaishan@gmail.com

# ImageKit.io Media CDN Configuration
REACT_APP_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/x2eerczu0
REACT_APP_IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key_here

# Vercel image uploads use the same Firebase project and admin email as the web app.
# Keep the ImageKit private key in server-only environment variables.
# IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key_here

# Enable only when the upload functions have Google application default credentials with Firebase Auth user-read access.
# FIREBASE_CHECK_REVOKED=true
