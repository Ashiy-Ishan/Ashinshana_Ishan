# ==============================================================================
# React Frontend Environment Variables (GitHub Pages Build / Local Dev)
# ==============================================================================
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id
REACT_APP_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Authorized Admin Email (CMS Login)
REACT_APP_ADMIN_EMAIL=ashinshanaishan@gmail.com

# ImageKit Public Endpoint (For CDN Asset Serving)
REACT_APP_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id/

# Vercel Serverless Upload API URL (Production & Local)
# Production: https://your-vercel-domain.vercel.app/api/upload-image
# Local Development: http://localhost:3000/api/upload-image
REACT_APP_UPLOAD_API_URL=https://your-vercel-domain.vercel.app/api/upload-image

# Disable Source Maps in production build
GENERATE_SOURCEMAP=false

# ==============================================================================
# Vercel Serverless API Environment Variables (Set in Vercel Project Settings)
# DO NOT ADD PRIVATE KEYS TO FRONTEND .env OR COMMIT TO GIT
# ==============================================================================
# IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
# IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
# IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id/
# FIREBASE_PROJECT_ID=your_firebase_project_id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

