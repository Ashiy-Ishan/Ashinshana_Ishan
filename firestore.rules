rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email_verified == true &&
             request.auth.token.auth_time is int &&
             request.time < timestamp.value(request.auth.token.auth_time * 1000) + duration.value(12, 'h') &&
             request.auth.token.email != null &&
             request.auth.token.email.lower() == 'ashinshanaishan@gmail.com';
    }

    function isPublicCollection(name) {
      return name in [
        'profiles', 'skills', 'projects', 'publishedProjects', 'youtubeChannel',
        'youtubeVideos', 'currentlyBuilding', 'timeline', 'gallery',
        'siteSettings', 'achievements'
      ];
    }

    match /{name}/{id} {
      allow read: if isPublicCollection(name);
      allow write: if isPublicCollection(name) && isAdmin();
    }

    function validMessage(data) {
      return data.keys().hasAll(['name', 'email', 'subject', 'message', 'createdAt', 'read', 'serverTimestamp']) &&
             data.keys().hasOnly(['name', 'email', 'subject', 'message', 'createdAt', 'read', 'serverTimestamp']) &&
             data.name is string && data.name.size() <= 100 && data.name.matches('(?s).*[^[:space:]].*') &&
             data.email is string && data.email.size() <= 254 &&
             data.email.matches('^[A-Za-z0-9._+%-]+@[A-Za-z0-9.-]+[.][A-Za-z0-9-]+$') &&
             data.subject is string && data.subject.size() <= 150 &&
             data.message is string && data.message.size() <= 5000 && data.message.matches('(?s).*[^[:space:]].*') &&
             data.createdAt is string && data.createdAt.size() == 24 &&
             data.read == false && data.serverTimestamp == request.time;
    }

    match /contactMessages/{id} {
      allow create: if validMessage(request.resource.data);
      allow read, update, delete: if isAdmin();
    }
  }
}
