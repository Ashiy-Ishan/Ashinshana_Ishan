rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the requesting user is the authorized portfolio administrator
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email != null &&
             request.auth.token.email.lower() == 'ashinshanaishan@gmail.com';
    }

    // Public portfolio documents - Read by anyone, Write restricted to authorized admin
    match /portfolio/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /skills/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /projects/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /published/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /building/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /achievements/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gallery/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

