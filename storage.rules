rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if the requesting user is the authorized administrator
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email_verified == true &&
             request.auth.token.auth_time is int &&
             request.time < timestamp.value(request.auth.token.auth_time * 1000) + duration.value(12, 'h') &&
             request.auth.token.email != null &&
             request.auth.token.email.lower() == 'ashinshanaishan@gmail.com';
    }

    // Helper function to validate uploaded file size & image format
    function isValidImage() {
      return request.resource.size <= 5 * 1024 * 1024 &&
             request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    match /{allPaths=**} {
      allow get: if isAdmin() || resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow list: if isAdmin();
      // Only authorized admin can upload/update/delete images with size & format validation
      allow create, update: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }
  }
}

